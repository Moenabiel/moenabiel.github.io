---
// Contact + footer. GitHub only — nothing else is authorized.
const year = new Date().getFullYear();
---

<section class="section" id="contact">
  <div class="wrap">
    <p class="kicker" data-reveal>~/contact</p>
    <div class="contact-box" data-reveal>
      <p class="big">Want to see how something was built?</p>
      <p>Every project here is on GitHub. Open an issue, start a discussion, or fork and inspect.</p>
      <a class="btn" href="https://github.com/Moenabiel" rel="noopener">github.com/Moenabiel</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer-inner">
    <span>© {year} nabiel — built with astro · gsap · lenis</span>
    <span>
      <a href="https://github.com/Moenabiel" rel="noopener">github</a>
      <span aria-hidden="true"> · </span>
      <a href="#top">back to top ↑</a>
    </span>
  </div>
</footer>
